{
  "name": "conquest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4317",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4318",
    "check": "tsx scripts/check-map.ts",
    "geo": "tsx scripts/build-geometry.ts",
    "predev": "npm run geo",
    "prebuild": "npm run geo",
    "build:single": "npm run geo && tsc && vite build --config vite.single.config.ts"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.6",
    "@types/polylabel": "^2.0.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "d3-delaunay": "^6.0.5",
    "polyclip-ts": "^0.16.8",
    "polylabel": "^2.1.0"
  }
}
